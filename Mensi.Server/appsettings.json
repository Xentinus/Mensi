{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Display": { "TimeZone": "Europe/Budapest" },
  "Audit": { "RetentionDays": 365 },
  "AllowedHosts": "*"
}
